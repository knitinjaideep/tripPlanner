# Copy to .env.local (git-ignored) and fill in. See docs/local-setup.md.
# All values are server-only. Never prefix any of them with NEXT_PUBLIC_.
# Use the database and the Auth URL from the SAME Neon branch.

# Pooled connection string (host contains "-pooler") — used by the app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional: direct (non-pooled) connection string for `npm run db:migrate`.
# Falls back to DATABASE_URL when unset.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Console → your branch → Auth → Configuration → Auth URL.
NEON_AUTH_BASE_URL=https://ep-example-123456.neonauth.us-east-2.aws.neon.tech/neondb/auth

# Signs the session cache cookie. At least 32 characters: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace-with-output-of-openssl-rand-base64-32

# --- Trip sharing (optional) -------------------------------------------------
# Invitation links always work ("Copy invite link"). Emailing them needs ALL THREE below;
# without them the app says "Email delivery is not configured" and sends nothing.
# Canonical public origin used in invitation links (https; http only for localhost). Never taken from request headers.
APP_ORIGIN=https://travel.example.com
# Resend (https://resend.com) server-side API key and a verified sender.
RESEND_API_KEY=
INVITE_EMAIL_FROM="Atlas <invites@example.com>"
# Optional, development: send every invitation to this address instead of the real recipient.
INVITE_EMAIL_DEV_INBOX=
