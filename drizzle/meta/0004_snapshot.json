          "value": "\"itinerary_items\".\"category\" in ('activity', 'sightseeing', 'food', 'transport', 'lodging', 'rest', 'other')"
        },
        "itinerary_items_schedule_source": {
          "name": "itinerary_items_schedule_source",
          "value": "(\"itinerary_items\".\"reservation_id\" is null and \"itinerary_items\".\"local_date\" is not null and \"itinerary_items\".\"timezone\" is not null)\n        or (\"itinerary_items\".\"reservation_id\" is not null and \"itinerary_items\".\"local_date\" is null and \"itinerary_items\".\"local_start_time\" is null\n            and \"itinerary_items\".\"local_end_date\" is null and \"itinerary_items\".\"local_end_time\" is null and \"itinerary_items\".\"timezone\" is null)"
        },
        "itinerary_items_timezone_length": {
