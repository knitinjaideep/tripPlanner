        },
        "itinerary_items_end_after_start": {
          "name": "itinerary_items_end_after_start",
          "value": "\"itinerary_items\".\"local_end_date\" >= \"itinerary_items\".\"local_date\""
        },
        "itinerary_items_end_time_valid": {
          "name": "itinerary_items_end_time_valid",
          "value": "\"itinerary_items\".\"local_end_time\" is null\n        or coalesce(\"itinerary_items\".\"local_end_date\", \"itinerary_items\".\"local_date\") > \"itinerary_items\".\"local_date\"\n        or (\"itinerary_items\".\"local_start_time\" is not null and \"itinerary_items\".\"local_end_time\" > \"itinerary_items\".\"local_start_time\")"
        },
        "itinerary_items_status_valid": {
          "name": "itinerary_items_status_valid",
          "value": "\"itinerary_items\".\"status\" in ('planned', 'completed', 'skipped')"
        },
        "itinerary_items_completed_at_matches": {
          "name": "itinerary_items_completed_at_matches",
          "value": "(\"itinerary_items\".\"status\" = 'completed') = (\"itinerary_items\".\"completed_at\" is not null)"
        },
        "itinerary_items_rating_range": {
          "name": "itinerary_items_rating_range",
          "value": "\"itinerary_items\".\"rating\" between 1 and 5"
        },
        "itinerary_items_planning_notes_length": {
          "name": "itinerary_items_planning_notes_length",
          "value": "char_length(\"itinerary_items\".\"planning_notes\") <= 5000"
